# The team relay. Locally, a relay on your machine, such as `nak serve --auth` (see README.md).
RELAY_URL=ws://localhost:10547
# The indexer's own Nostr key, whitelisted on the relay: `pnpm --filter @freemadeira/indexer key`.
INDEXER_KEY=
# Each site and the freehub project its blog comes from. `pnpm --filter @freemadeira/indexer seed` prints one for local work.
SITES=[{"site":"freemadeira","project":"30304:<project creator hex>:<project d>","url":"http://localhost:4321","locales":["pt","en"]}]
# sqld. Locally, `docker compose -f infra/compose.yaml up -d` from the repository root, without a token.
LIBSQL_URL=http://127.0.0.1:8080
LIBSQL_AUTH_TOKEN=
# The sites' ISR_BYPASS_TOKEN, so changed pages are rendered again at once.
REVALIDATE_TOKEN=
# Comma-separated public relays to look bylines' profiles up on.
# PROFILE_RELAYS=wss://purplepag.es,wss://relay.damus.io
PORT=3000
# Only for `seed`: the key that creates the sample project and writes its posts.
SEED_KEY=
