{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ISR_BYPASS_TOKEN", "EXPO_PUBLIC_*"],
      "outputs": ["dist/**", ".vercel/output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "app#dev": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "test": {},
    "typecheck": {}
  }
}
