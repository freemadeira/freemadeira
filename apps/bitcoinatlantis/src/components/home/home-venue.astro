---
import { toLocale } from "@freemadeira/i18n";
import { Image } from "astro:assets";

import venueImage from "@/assets/venue.jpg";
import Section from "@/components/section.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
---

<Section
  id="the-venue"
  title={m.home_venue_title({}, { locale })}
  subtitle={m.home_venue_subtitle({}, { locale })}
>
  <div class="mt-6 flex w-full justify-center">
    <Image
      class="rounded-lg md:rounded-2xl"
      src={venueImage}
      width={800}
      height={450}
      densities={[1, 2]}
      alt={m.home_venue_title({}, { locale })}
    />
  </div>
</Section>
