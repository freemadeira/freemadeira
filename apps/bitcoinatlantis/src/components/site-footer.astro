---
import { toLocale } from "@freemadeira/i18n";

import { routes } from "@/i18n/routes";
import type { Route } from "@/i18n/routes";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);

const links: [Route, string][] = [
  ["venueMap", m.nav_venue_map({}, { locale })],
  ["bookCorner", m.nav_book_corner({}, { locale })],
  ["kidsBlock", m.nav_kids_block({}, { locale })],
  ["atlanticBazaar", m.nav_atlantic_bazaar({}, { locale })],
  ["artGallery", m.nav_art_gallery({}, { locale })],
  ["plan", m.nav_plan({}, { locale })],
  ["why", m.nav_why({}, { locale })],
  ["faq", m.nav_faq({}, { locale })],
];
---

<footer class="bg-white">
  <div class="mx-auto max-w-7xl overflow-hidden px-6 py-20 sm:py-24 lg:px-8">
    <nav
      class="-mb-6 columns-2 sm:flex sm:justify-center sm:space-x-12"
      aria-label={m.footer_nav_label({}, { locale })}
    >
      {
        links.map(([route, label]) => (
          <div class="pb-6">
            <a
              href={routes[route][locale]}
              class="text-sm leading-6 text-gray-600 hover:text-gray-900"
            >
              {label}
            </a>
          </div>
        ))
      }
    </nav>
    <div class="mt-10 flex justify-center space-x-10">
      <a href="https://njump.me/npub1etgqcj9gc6yaxttuwu9eqgs3ynt2dzaudvwnrssrn2zdt2useaasfj8n6e" class="text-gray-400 hover:text-gray-500">
