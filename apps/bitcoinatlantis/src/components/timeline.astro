---
import { toLocale } from "@freemadeira/i18n";
import { Image } from "astro:assets";

import atlasLogo from "@/assets/logos/events/atlas.svg";
import holecoinerLogo from "@/assets/logos/events/holecoiner.svg";
import megaPlebDinnerLogo from "@/assets/logos/events/mega-pleb-dinner.svg";
import riseOfAtlantisLogo from "@/assets/logos/events/rise-of-atlantis.svg";
import debifiLogo from "@/assets/logos/partners/debifi.svg";
import amberAppLogo from "@/assets/logos/sponsors/amber-app.svg";
import { routes } from "@/i18n/routes";
import { m } from "@/paraglide/messages.js";

import TimelineTime from "./timeline-time.astro";

const locale = toLocale(Astro.currentLocale);
---

{/* The date pills are bg-gray-200: the 2024 Pill also passed bg-basalt-lighter, but Tailwind 3 let its default win. */}
{/* Hand-placed for the English labels, as on the 2024 site. A card that later
    cards are placed from keeps its English width (w-[…]), so a Portuguese
    label, longer or shorter, doesn't push the rest of its day off its lines. */}
<div
  data-timeline
  class="relative mt-16 flex cursor-grab gap-x-4 overflow-x-auto pt-[305px] pb-[25px] pl-3 whitespace-nowrap scrollbar-hide data-dragging:cursor-grabbing"
>
  <svg
    data-swipe-gesture
    aria-hidden="true"
