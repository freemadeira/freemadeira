<script>
  // Drag to scroll on desktop; the swipe hint goes once the reader scrolls.
  for (const timeline of document.querySelectorAll<HTMLElement>(
    "[data-timeline]"
  )) {
    const gesture = timeline.querySelector("[data-swipe-gesture]");
    let startX = 0;
    let startScroll = 0;

    timeline.addEventListener(
      "scroll",
      () => {
        gesture?.remove();
      },
      { once: true, passive: true }
    );
    timeline.addEventListener("mousedown", (event) => {
      timeline.dataset.dragging = "";
      startX = event.pageX - timeline.offsetLeft;
      startScroll = timeline.scrollLeft;
    });
    for (const type of ["mouseleave", "mouseup"]) {
      timeline.addEventListener(type, () => {
        delete timeline.dataset.dragging;
      });
    }
    timeline.addEventListener("mousemove", (event) => {
      if (timeline.dataset.dragging === undefined) {
        return;
      }
      event.preventDefault();
      const x = event.pageX - timeline.offsetLeft;
      timeline.scrollLeft = startScroll - (x - startX) * 2;
    });
  }
</script>
