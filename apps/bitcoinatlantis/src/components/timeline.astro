    <ol class="flex w-[600px] ml-[125px]">
      <div class="flex-start block">
        <div class="border-l-2 border-basalt h-32 -mt-[156px]" />
      </div>
      <a href={routes.holecoiner[locale]}>
        <li class="-mt-[350px] -ml-3 hover:bg-yellow-50 p-2 rounded-lg transition-all duration-300">
          <Image src={holecoinerLogo} alt="Holecoiner" class="w-32" />
