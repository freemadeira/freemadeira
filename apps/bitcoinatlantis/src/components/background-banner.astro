---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  class?: string;
  image: ImageMetadata;
}

const { class: className, image } = Astro.props;
const background = await getImage({
  format: "webp",
  src: image,
  width: Math.min(image.width, 2000),
});
---

<div
  class:list={["bg-cover", className]}
  style={`background-image: url(${background.src})`}
>
  <slot />
</div>
