---
import { Image } from "astro:assets";

import SocialLinks from "@/components/social-links.astro";
import { remainingSpeakers } from "@/data/speakers";
---

<section id="all" class="mt-4 sm:-mt-4">
  <div
    class="mt-10 grid grid-cols-1 items-start gap-x-4 gap-y-4 sm:mt-12 sm:gap-y-8 lg:mt-16 lg:grid-cols-4"
  >
    <div
      class="grid grid-cols-1 gap-x-2.5 gap-y-10 sm:grid-cols-2 md:grid-cols-2 md:gap-x-4 lg:col-span-4 lg:grid-cols-4"
    >
      {
        remainingSpeakers.map((speaker) => (
          <div class="flex items-center justify-between">
            <div class="group relative h-20 w-[30%] transform overflow-hidden rounded-3xl md:h-28 md:w-[50%]">
              <div class="absolute inset-0 flex bg-yellow-50">
                <Image
                  class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-110"
                  src={speaker.image}
                  alt=""
                  widths={[140, 280]}
                  sizes="(min-width: 1280px) 8.75rem, (min-width: 1024px) 12.5vw, (min-width: 768px) 16.5vw, (min-width: 640px) 25vw, 50vw"
                />
              </div>
            </div>
            {/* Long single-word roles ("Cryptosovereignty") break rather than spill. */}
            <div class="ml-4 w-[70%] wrap-break-word md:w-[50%]">
              <h3 class="font-display font-bold tracking-tight text-slate-900">
                {speaker.name}
              </h3>
              <p class="mt-1 text-sm tracking-tight text-slate-500">
                {speaker.role}
              </p>
              <SocialLinks twitter={speaker.twitter} nostr={speaker.nostr} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
