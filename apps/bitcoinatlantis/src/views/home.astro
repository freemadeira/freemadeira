---
import { toLocale } from "@freemadeira/i18n";

import HomeHero from "@/components/home/home-hero.astro";
import HomeSpeakers from "@/components/home/home-speakers.astro";
import HomeVenue from "@/components/home/home-venue.astro";
import MadeiraHero from "@/components/home/madeira-hero.astro";
import Programme from "@/components/home/programme.astro";
import Sponsors from "@/components/home/sponsors.astro";
import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
---

<Layout
  description={m.home_description({}, { locale })}
  route="home"
  title={m.home_title({}, { locale })}
>
  <main>
    <HomeHero />
    <HomeSpeakers />
    <Programme />
    <HomeVenue />
    <MadeiraHero />
    <Sponsors />
  </main>
</Layout>
