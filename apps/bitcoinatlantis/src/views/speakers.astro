---
import { toLocale } from "@freemadeira/i18n";

import BackgroundEffect from "@/components/background-effect.astro";
import Container from "@/components/container.astro";
import PageHero from "@/components/page-hero.astro";
import Seal from "@/components/seal.astro";
import HighlightedSpeakers from "@/components/speakers/highlighted-speakers.astro";
import RemainingSpeakers from "@/components/speakers/remaining-speakers.astro";
import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
---

<Layout
  description={m.speakers_description({}, { locale })}
  route="speakers"
  title={m.speakers_meta_title({}, { locale })}
>
  <BackgroundEffect>
    <PageHero
      title={m.speakers_title({}, { locale })}
      subtitle={m.speakers_subtitle({}, { locale })}
    />
    <Container>
      {/* Above the title until xl: lower down it would cover the centred subtitle. */}
      <div
        class="absolute -top-4 right-4 z-10 overflow-hidden xl:top-16 xl:right-20"
      >
        <Seal
          class="relative size-28 overflow-visible fill-red-600 stroke-red-800 sm:size-32"
        />
      </div>
      <section class="mt-4 sm:-mt-8">
        <HighlightedSpeakers />
      </section>
      <RemainingSpeakers />
    </Container>
  </BackgroundEffect>
</Layout>
