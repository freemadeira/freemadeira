---
import { toLocale } from "@freemadeira/i18n";

import { routes } from "@/i18n/routes";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
const current = Astro.url.pathname.replace(/\/$/u, "");

const links = [
  { href: routes.apoio[locale], label: m.apoio_nav_guide({}, t) },
  // The FAQ and glossary are Portuguese only, so English visitors get the
  // flyer and the guide home.
  ...(locale === "pt"
    ? [
        {
          href: `${routes.apoio.pt}/perguntas-frequentes`,
          label: m.apoio_nav_faq({}, t),
        },
      ]
    : []),
  { href: routes.apoioFlyer[locale], label: m.apoio_nav_flyer({}, t) },
  ...(locale === "pt"
    ? [
        {
          href: `${routes.apoio.pt}/glossario`,
          label: m.apoio_nav_glossary({}, t),
        },
      ]
    : []),
];
---

<div class="border-y border-mountain-mist-200 bg-bridal-50 print:hidden">
  <nav
    aria-label={m.apoio_nav_label({}, t)}
    class="mx-auto flex w-full max-w-[1536px] flex-wrap items-center gap-x-6 gap-y-1 px-4 py-2 sm:px-8 md:px-10 xl:px-12"
  >
    <a class="mr-2 text-xl font-semibold" href={routes.apoio[locale]}>
      {m.apoio_nav_home({}, t)}
    </a>
    {
      links.map((link) => (
        <a
          aria-current={current === link.href ? "page" : undefined}
          class="border-b-2 border-transparent py-1.5 text-[0.95rem] hover:border-primary-500 aria-[current=page]:border-primary-500"
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>
