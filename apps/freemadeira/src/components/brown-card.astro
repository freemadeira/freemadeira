---
import { cn } from "cn";
import type { LucideIcon } from "lucide-react";

import DiscreetLink from "@/components/discreet-link.astro";
import { heading } from "@/lib/typography";

interface Props {
  /** Includes the width, from the breakpoint where the cards sit side by side. */
  class?: string;
  icon: LucideIcon;
  link?: { href: string; label: string };
  title: string;
  /**
   * The about page's large heading, centred on the icon, or the Madeira
   * guide's smaller title, level with the icon's top and further from the list.
   */
  variant: "about" | "guide";
}

const { class: className, icon: Icon, link, title, variant } = Astro.props;
const guide = variant === "guide";
---

<div
  class={cn(
    "flex w-full min-w-0 flex-col gap-8 bg-bridal-700 text-white sm:gap-12",
    className
  )}
>
  <div class:list={["flex grow flex-col gap-8", !guide && "md:gap-6"]}>
    <div class:list={["flex gap-4", !guide && "items-center"]}>
      {/* The about page's icon gives way to a long word on narrow cards, and
          a word that still doesn't fit ("Encontros", "deslocares") is
          hyphenated. Only words of seven letters or more, so a short one
          ("chegar") moves to the next line instead. */}
      <Icon
        aria-hidden="true"
        className={guide ? "size-12 shrink-0" : "size-12"}
      />
      <h3
        class={cn(
          guide ? "text-4xl leading-none" : heading.h3,
          "min-w-0 hyphens-auto wrap-break-word [hyphenate-limit-chars:7_4_3]"
        )}
      >
        {title}
      </h3>
    </div>
    <slot />
  </div>
  {link && <DiscreetLink href={link.href}>{link.label}</DiscreetLink>}
</div>
