---
import { cn } from "cn";
import type { LucideIcon } from "lucide-react";

import DiscreetLink from "@/components/discreet-link.astro";

interface Props {
  class?: string;
  icon: LucideIcon;
  link?: { href: string; label: string };
  title: string;
  /** The about page's large heading, or the Madeira guide's smaller title. */
  titleClass: string;
}

const { class: className, icon: Icon, link, title, titleClass } = Astro.props;
---

<div
  class={cn(
    "flex w-full flex-col gap-8 bg-bridal-700 text-white sm:w-1/2 sm:gap-12",
    className
  )}
>
  <div class="flex grow flex-col gap-8 md:gap-6">
    <div class="flex items-center gap-4">
      <Icon aria-hidden="true" className="size-12 shrink-0" />
      <h3 class={titleClass}>{title}</h3>
    </div>
    <slot />
  </div>
  {link && <DiscreetLink href={link.href}>{link.label}</DiscreetLink>}
</div>
