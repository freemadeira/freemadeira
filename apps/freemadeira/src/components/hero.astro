---
import { buttonVariants } from "@freemadeira/ui/components/button";
import type { SvgComponent } from "astro/types";
import { cn } from "cn";

import Container from "@/components/container.astro";
import { externalLinkProps } from "@/lib/links";
import { heading } from "@/lib/typography";

interface Props {
  button?: { href: string; label: string };
  illustration: SvgComponent;
  illustrationClass?: string;
  /** Even halves, for a square illustration. */
  layout?: "default" | "tight";
  subtitle?: string;
  title: string;
}

const {
  button,
  illustration: Illustration,
  illustrationClass,
  layout = "default",
  subtitle,
  title,
} = Astro.props;
---

<Container class="my-16 flex-col-reverse gap-6 sm:flex-row sm:gap-10">
  <div
    class:list={[
      "flex w-full flex-col gap-6 sm:gap-14",
      layout === "tight" ? "sm:w-1/2" : "sm:w-3/5",
    ]}
  >
    <div class="flex flex-col gap-4 sm:gap-8">
      <slot name="pill" />
      <h1 class={heading.h1}>{title}</h1>
      {subtitle && <p class={heading.h4}>{subtitle}</p>}
      <p class={heading.h6}><slot /></p>
    </div>
    {
      button && (
        <a
          class={buttonVariants({ variant: "fm" })}
          href={button.href}
          {...externalLinkProps(button.href)}
        >
          {button.label}
        </a>
      )
    }
  </div>
  <Illustration
    aria-hidden="true"
    class={cn(
      "h-auto w-full",
      layout === "tight" ? "sm:w-1/2" : "sm:w-2/5",
      illustrationClass
    )}
  />
</Container>
