---
import { toLocale } from "@freemadeira/i18n";

import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
---

<Layout
  description={m.about_description({}, { locale })}
  route="about"
  title={m.about_title({}, { locale })}
>
  <main class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-24">
    <h1 class="text-4xl font-semibold tracking-tight">
      {m.about_title({}, { locale })}
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">
      {m.about_description({}, { locale })}
    </p>
  </main>
</Layout>
