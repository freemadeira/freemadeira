---
import { toLocale } from "@freemadeira/i18n";

import Container from "@/components/container.astro";
import Contribute from "@/components/contribute.astro";
import PersonCard from "@/components/person-card.astro";
import { advisoryBoardMembers } from "@/data/advisory-board";
import { teamMembers } from "@/data/team";
import { routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
// One column on phones, two once a 16rem portrait fits twice (before sm).
const grid =
  "my-12 grid grid-cols-[repeat(auto-fill,minmax(min(100%,16rem),1fr))] gap-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4";
---

<Layout
  description={m.team_page_description({}, t)}
  paths={routes.team}
  title={m.team_page_title({}, t)}
>
  <Container class="@container mt-16">
    <h1 class={heading.h1}>{m.team_title({}, t)}</h1>
    <div class={grid}>
      {teamMembers.map((person) => <PersonCard person={person} />)}
    </div>
  </Container>

  <Container class="@container my-16">
    <h2 class={heading.h1}>{m.advisory_title({}, t)}</h2>
    <div class={grid}>
      {advisoryBoardMembers.map((person) => <PersonCard person={person} />)}
    </div>
  </Container>

  <Contribute />
</Layout>
