---
import { toLocale } from "@freemadeira/i18n";
import { ArrowRight, MapPinned, Zap } from "lucide-react";

import funchalImage from "@/assets/images/madeira-carousel/madeira-funchal.jpg";
import merchantsImage from "@/assets/images/madeira-carousel/madeira-merchants.jpeg";
import mountainSeaImage from "@/assets/images/madeira-carousel/madeira-mountain-sea.jpg";
import renewableEnergyImage from "@/assets/images/madeira-carousel/madeira-renewable-energy.jpg";
import MadeiraIllustration from "@/assets/illustrations/madeira.svg";
import NostrMobile from "@/assets/illustrations/nostr-mobile.svg";
import TelegramLady from "@/assets/illustrations/telegram-lady.svg";
import BrownCard from "@/components/brown-card.astro";
import Container from "@/components/container.astro";
import Contribute from "@/components/contribute.astro";
import EventRow from "@/components/event-row.astro";
import Hero from "@/components/hero.astro";
import SlideCarousel from "@/components/slide-carousel";
import { recurringEvents } from "@/data/events";
import { flights } from "@/data/flights";
import { organisation } from "@/data/organisation";
import { freeMadeiraNpub } from "@/data/socials";
import { routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { slideImage } from "@/lib/images";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };

/** Madeira's offset from GMT on the day the page is built: +0, or +1 in summer. */
function madeiraOffset(date = new Date()): string {
  const name = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Atlantic/Madeira",
    timeZoneName: "shortOffset",
  })
    .formatToParts(date)
    .find((part) => part.type === "timeZoneName")?.value;
  return name === "GMT" ? "GMT+0" : (name ?? "GMT+0");
}

const subject = encodeURIComponent(m.madeira_slide_adoption_subject({}, t));
const slides = [
  {
    buttons: [
      {
        href: "https://btcmap.org/community/free-madeira/merchants",
        label: m.madeira_slide_island_button({}, t),
      },
    ],
    image: await slideImage(mountainSeaImage),
    subtitle: m.madeira_slide_island_subtitle({}, t),
    text: m.madeira_slide_island_text({}, t),
    title: m.madeira_slide_island_title({}, t),
  },
  {
    buttons: [
      {
        href: "https://freeenergysummit.com",
        label: m.madeira_slide_energy_button({}, t),
      },
    ],
    image: await slideImage(renewableEnergyImage),
    subtitle: m.madeira_slide_energy_subtitle({}, t),
    text: m.madeira_slide_energy_text({}, t),
    title: m.madeira_slide_energy_title({}, t),
  },
  {
    buttons: [
      {
        href: `https://www.satlantis.io/p/${freeMadeiraNpub}`,
        label: m.madeira_slide_climate_button({}, t),
      },
    ],
    image: await slideImage(funchalImage),
    subtitle: m.madeira_slide_climate_subtitle({}, t),
    text: m.madeira_slide_climate_text({}, t),
    title: m.madeira_slide_climate_title({}, t),
  },
  {
    buttons: [
      {
        href: `mailto:${organisation.email}?subject=${subject}`,
        label: m.madeira_slide_adoption_button({}, t),
      },
    ],
    image: await slideImage(merchantsImage),
    subtitle: m.madeira_slide_adoption_subtitle({}, t),
    text: m.madeira_slide_adoption_text({}, t),
    title: m.madeira_slide_adoption_title({}, t),
  },
];

const community = [
  {
    button: m.madeira_telegram_button({}, t),
    href: "https://t.me/freemadeira",
    illustration: TelegramLady,
    illustrationClass:
      "absolute right-4 bottom-0 h-[200px] w-auto lg:right-4 lg:h-2/3 xl:h-5/6",
    text: m.madeira_telegram_text({}, t),
    title: "Telegram — FREE Madeira",
  },
  {
    button: m.madeira_nostr_button({}, t),
    href: `https://njump.me/${freeMadeiraNpub}`,
    illustration: NostrMobile,
    illustrationClass:
      "absolute -right-8 -bottom-4 h-[200px] w-auto lg:-right-10 lg:h-2/3 xl:h-5/6",
    text: m.madeira_nostr_text({}, t),
    title: "Nostr",
  },
];
const tag = "flex items-center text-lg leading-[150%]";
---

<Layout
  description={m.madeira_hero_text({}, t)}
  paths={routes.madeira}
  title={m.madeira_title({}, t)}
>
  <Hero
    button={{
      href: `https://visitmadeira.com/${locale}`,
      label: m.madeira_explore({}, t),
    }}
    illustration={MadeiraIllustration}
    subtitle={m.madeira_subtitle({}, t)}
    title={m.madeira_title({}, t)}
  >
    <span
      class="flex w-fit items-center gap-2 rounded-full border border-mountain-mist-200 px-2.5 py-2 text-sm leading-2.5 text-mountain-mist-500"
      slot="pill"
    >
      <span class="size-3 rounded-full bg-orange-500"></span>
      32°N · 17°W · {madeiraOffset()}
    </span>
    {m.madeira_hero_text({}, t)}
  </Hero>

  <div class="sm:pt-10">
    <SlideCarousel
      client:visible
      label={m.carousel_label({ name: m.madeira_title({}, t) }, t)}
      nextLabel={m.carousel_next({}, t)}
      previousLabel={m.carousel_previous({}, t)}
      slides={slides}
    />
  </div>

  <Container class="mt-28 mb-24" size="tight">
    <div class="flex flex-col gap-8">
      <h2 class={heading.h3}>{m.madeira_guide_title({}, t)}</h2>
      <p>{m.madeira_guide_text({}, t)}</p>
    </div>
    <div class="my-16 flex flex-col gap-7 sm:my-20 sm:flex-row sm:gap-9">
      <BrownCard
        class="px-12 py-10 lg:px-22 lg:py-12"
        icon={Zap}
        title={m.madeira_wallet_title({}, t)}
        variant="guide"
      >
        <ul class="list-inside list-disc space-y-2 text-lg">
          <li>{m.madeira_wallet_1({}, t)}</li>
          <li>{m.madeira_wallet_2({}, t)}</li>
          <li>{m.madeira_wallet_3({}, t)}</li>
        </ul>
      </BrownCard>
      <BrownCard
        class="px-12 py-10 lg:px-22 lg:py-12"
        icon={MapPinned}
        title={m.madeira_travel_title({}, t)}
        variant="guide"
      >
        <ul class="list-inside list-disc space-y-2 text-lg">
          <li>{m.madeira_travel_1({}, t)}</li>
          <li>{m.madeira_travel_2({}, t)}</li>
          <li>{m.madeira_travel_3({}, t)}</li>
        </ul>
      </BrownCard>
    </div>
  </Container>

  <section class="mb-28 bg-bridal-50">
    <Container class="gap-12 pt-18 pb-20" size="tight">
      <p class={tag}>{m.madeira_flights_tag({}, t)}</p>
      <div class="mb-4 flex flex-col gap-12 lg:mb-7 lg:flex-row">
        <div class="flex flex-2/5 flex-col justify-between gap-8">
          <h2 class={heading.h4}>{m.madeira_flights_title({}, t)}</h2>
        </div>
        <ul class="grid flex-3/5 grid-cols-1 sm:grid-cols-2 sm:gap-x-8">
          {
            flights.map((flight) => (
              <li class="flex gap-4 border-b border-mountain-mist-200 px-2 pt-6 pb-4">
                <span class="font-semibold">{flight.city[locale]}</span>
                <span class="text-mountain-mist-600">{flight.duration}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <EventRow events={recurringEvents} title={m.madeira_events_title({}, t)}>
    <p class="mx-4 sm:mx-0">{m.madeira_events_text({}, t)}</p>
  </EventRow>

  <Container class="my-28" size="tight">
    <div class="mb-18 flex flex-col items-center gap-8">
      <h2 class={heading.h3}>{m.madeira_community_title({}, t)}</h2>
      <p>{m.madeira_community_text({}, t)}</p>
    </div>
    <div class="flex w-full flex-col gap-5 lg:flex-row lg:gap-8">
      {
        community.map((card) => (
          <a
            class="group relative w-full flex-1 overflow-clip bg-bridal-50 p-7"
            href={card.href}
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="flex h-full w-2/3 flex-col justify-between space-y-6">
              <h3 class:list={[heading.h6, "z-10"]}>{card.title}</h3>
              <p class="text-lg">{card.text}</p>
              <span class="flex w-fit items-center gap-4">
                <span class="underline-offset-6 group-hover:underline">
                  {card.button}
                </span>
                <span class="rounded-full bg-primary-400 p-1 text-black">
                  <ArrowRight aria-hidden="true" size={22} strokeWidth={1.2} />
                </span>
              </span>
            </div>
            <card.illustration aria-hidden="true" class={card.illustrationClass} />
          </a>
        ))
      }
    </div>
  </Container>

  <Contribute />
</Layout>
