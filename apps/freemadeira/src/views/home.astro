---
import { toLocale } from "@freemadeira/i18n";
import { buttonVariants } from "@freemadeira/ui/components/button";

import { routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
---

<Layout
  description={m.home_description({}, { locale })}
  route="home"
  title={m.home_title({}, { locale })}
>
  <main class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-6 py-24">
    <h1 class="text-5xl font-semibold tracking-tight">
      {m.home_title({}, { locale })}
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">
      {m.home_description({}, { locale })}
    </p>
    <a class={buttonVariants({ size: "lg" })} href={routes.about[locale]}>
      {m.about_title({}, { locale })}
    </a>
  </main>
</Layout>
