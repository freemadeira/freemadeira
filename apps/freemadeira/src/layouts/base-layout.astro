---
import "@/styles/global.css";

import {
  defaultLocale,
  htmlLang,
  locales,
  toLocale,
} from "@freemadeira/i18n";
import type { PostImage } from "@freemadeira/db";
import type { LocalizedPaths } from "@freemadeira/i18n";

import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";

interface Props {
  /** A blog post: shared as an article, with its cover. */
  article?: { cover: PostImage | null; publishedAt: Date; updatedAt: Date };
  /**
   * The locales this page exists in, for hreflang, when not all of them: a
   * post without a translation. The language switcher still uses `paths`.
   */
  alternates?: Partial<LocalizedPaths>;
  description: string;
  /** For pages that shouldn't be in search results, such as preferences. */
  noindex?: boolean;
  /** This page's path in each locale. */
  paths: LocalizedPaths;
  /** The page's own title; the site name is added after it. */
  title?: string;
}

const {
  alternates,
  article,
  description,
  noindex = false,
  paths,
  title,
} = Astro.props;
const locale = toLocale(Astro.currentLocale);
const site = Astro.site ?? Astro.url;
const fullTitle = title ? `${title} – FREE Madeira` : "FREE Madeira";
const canonical = new URL(paths[locale], site);
const translations = locales.filter((alternate) =>
  alternates ? alternates[alternate] !== undefined : true
);
const translated = (alternate: (typeof locales)[number]) =>
  alternates?.[alternate] ?? paths[alternate];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      translations.length > 1 &&
        translations.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate}
            href={new URL(translated(alternate), site)}
          />
        ))
    }
    {
      translations.length > 1 && translations.includes(defaultLocale) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(translated(defaultLocale), site)}
        />
      )
    }
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="FREE Madeira" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang[locale].replace("-", "_")} />
    <meta
      name="twitter:card"
      content={article?.cover ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:site" content="@FREEMadeiraOrg" />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedAt.toISOString()}
          />
          <meta
            property="article:modified_time"
            content={article.updatedAt.toISOString()}
          />
        </>
      )
    }
    {
      article?.cover && (
        <>
          <meta property="og:image" content={article.cover.url} />
          <meta property="og:image:width" content={String(article.cover.width)} />
          <meta
            property="og:image:height"
            content={String(article.cover.height)}
          />
          <meta property="og:image:alt" content={article.cover.alt} />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader paths={paths} />
    <main class="grow">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
