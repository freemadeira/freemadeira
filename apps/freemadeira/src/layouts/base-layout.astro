---
import "@/styles/global.css";

import {
  defaultLocale,
  htmlLang,
  locales,
  toLocale,
} from "@freemadeira/i18n";
import type { LocalizedPaths } from "@freemadeira/i18n";

import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";

interface Props {
  description: string;
  /** For pages that shouldn't be in search results, such as preferences. */
  noindex?: boolean;
  /** This page's path in each locale. */
  paths: LocalizedPaths;
  /** The page's own title; the site name is added after it. */
  title?: string;
}

const { description, noindex = false, paths, title } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const site = Astro.site ?? Astro.url;
const fullTitle = title ? `${title} – FREE Madeira` : "FREE Madeira";
const canonical = new URL(paths[locale], site);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate}
          href={new URL(paths[alternate], site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(paths[defaultLocale], site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FREE Madeira" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang[locale].replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@FREEMadeiraOrg" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader paths={paths} />
    <main class="grow">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
