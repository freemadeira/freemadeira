---
import { toLocale } from "@freemadeira/i18n";
import type { LocalizedPaths } from "@freemadeira/i18n";

import ApoioNav from "@/components/apoio/apoio-nav.astro";
import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

interface Props {
  /** The locales this page exists in, when not all of them. */
  alternates?: Partial<LocalizedPaths>;
  description?: string;
  paths: LocalizedPaths;
  title?: string;
}

const { alternates, description, paths, title } = Astro.props;
const t = { locale: toLocale(Astro.currentLocale) };
---

<Layout
  alternates={alternates}
  description={description ?? m.apoio_description({}, t)}
  paths={paths}
  title={title ? `${title} · ${m.apoio_title({}, t)}` : m.apoio_title({}, t)}
>
  <ApoioNav />
  <slot />
  <footer
    class="mx-auto mt-16 w-full max-w-5xl space-y-2 border-t border-mountain-mist-200 px-4 py-8 text-sm text-mountain-mist-500 sm:px-8 print:hidden"
  >
    <p>
      <strong>{m.apoio_footer_guide({}, t)}</strong> — {m.apoio_footer_published({}, t)}
    </p>
    <p>
      {m.apoio_footer_licence_pre({}, t)}{" "}
      <a
        class="underline"
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        rel="noopener noreferrer"
        target="_blank">CC BY-SA 4.0</a
      >{m.apoio_footer_licence_post({}, t)}
    </p>
    <p>{m.apoio_footer_inspired({}, t)}</p>
    <p>{m.apoio_footer_disclaimer({}, t)}</p>
  </footer>
</Layout>
