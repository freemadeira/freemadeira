# The newsletter sign-up and preferences endpoints. Set both in Vercel too.
MAILERLITE_TOKEN=
# At least 32 characters; seals the preferences page's cookie.
SESSION_PASSWORD=
# The blog, which the indexer writes to sqld. Locally: LIBSQL_URL=http://127.0.0.1:8080 and no token.
# On Vercel: https://db.freemadeira.org and a read-only token (`pnpm --filter @freemadeira/db tokens ro`).
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=
# At least 32 characters, read at build time. The indexer's REVALIDATE_TOKEN is the same value.
ISR_BYPASS_TOKEN=
