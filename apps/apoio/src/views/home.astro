---
import { toLocale } from "@freemadeira/i18n";
import { buttonVariants } from "@freemadeira/ui/components/button";

import Contact from "@/components/contact.astro";
import { tierVars } from "@/components/tiers";
import { CHAPTERS, TIERS } from "@/data";
import { start } from "@/data/home";
import { guidePath, routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
const linkClass = "underline underline-offset-4";
---

<Layout paths={routes.home}>
  <section class="mx-auto w-full max-w-5xl px-4 pt-12 pb-10 sm:px-8 sm:pt-20">
    <h1 class:list={[heading.h3, "max-w-[18ch] font-medium"]}>
      {m.home_headline({}, t)}
    </h1>
    <p class="mt-6 max-w-xl text-xl text-mountain-mist-500">
      {m.home_sub({}, t)}
    </p>
    <p class="mt-8">
      <a class={buttonVariants({ variant: "fm" })} href="#comecar">
        {m.home_start_button({}, t)}
      </a>
    </p>
  </section>

  {
    locale === "pt" ? (
      <section
        aria-label={m.home_doors_label({}, t)}
        class="mx-auto w-full max-w-5xl px-4 pt-6 sm:px-8"
      >
        <div class="grid items-end gap-5 md:grid-cols-3 md:gap-6">
          {TIERS.map((tier) => (
            <div
              class:list={[
                tierVars[tier.id],
                "rounded-t-[50%_6rem] bg-(--tier) px-7 pt-21 pb-11 text-(--tier-ink)",
                tier.id === "agora" && "min-h-88",
                tier.id === "balcao" && "min-h-100",
                tier.id === "depois" && "min-h-94",
              ]}
            >
              <h2 class={heading.h6}>{tier.label}</h2>
              <p class="mt-2 text-[0.95rem] leading-snug opacity-90">
                {tier.note}
              </p>
              <ul class="mt-4">
                {CHAPTERS.filter((chapter) => chapter.tier === tier.id).map(
                  (chapter) => (
                    <li class="border-t border-current/30 py-1.5 leading-snug">
                      <a class={linkClass} href={guidePath(chapter.slug)}>
                        {chapter.num}. {chapter.title}
                      </a>
                    </li>
                  )
                )}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 font-semibold">
          <a class={linkClass} href={guidePath("perguntas-frequentes")}>
            {m.home_faq({}, t)}
          </a>
          <a class={linkClass} href={routes.flyer.pt}>
            {m.home_flyer({}, t)}
          </a>
          <a class={linkClass} href={guidePath("glossario")}>
            {m.home_glossary({}, t)}
          </a>
        </p>
      </section>
    ) : (
      <section class="mx-auto w-full max-w-5xl px-4 pt-6 sm:px-8">
        <p class="max-w-xl text-lg">{m.home_guide_in_portuguese({}, t)}</p>
        <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 font-semibold">
          <a class={linkClass} href={routes.home.pt} hreflang="pt" lang="pt">
            {m.nav_guide({}, t)} (PT)
          </a>
          <a class={linkClass} href={routes.flyer.en}>
            {m.home_flyer({}, t)}
          </a>
        </p>
      </section>
    )
  }

  <section class="mx-auto w-full max-w-5xl px-4 pt-20 sm:px-8" id="comecar">
    <div class="max-w-2xl">
      <h2 class={heading.h4}>{start.title[locale]}</h2>
      <p class="mt-3">
        {start.lead[locale]}
      </p>
      <ol class="my-6 space-y-6 border-l-[3px] border-mountain-mist-200">
        {
          start.steps.map((step, index) => (
            <li class="relative min-h-10 pt-2 pl-13">
              <span
                aria-hidden="true"
                class="absolute -left-5.5 top-0 grid size-10 place-items-center rounded-full bg-primary-400 font-bold text-dark"
              >
                {index + 1}
              </span>
              {step[locale]}
            </li>
          ))
        }
      </ol>
      <ul class="my-6 list-disc space-y-2 pl-6">
        {start.points.map((point) => <li>{point[locale]}</li>)}
      </ul>
      <dl class="my-8 border-t-2 border-dark">
        {
          start.facts.map((fact) => (
            <div class="grid gap-0.5 border-b border-mountain-mist-200 py-3 sm:grid-cols-[11rem_1fr] sm:gap-4">
              <dt class="font-bold">{fact.label[locale]}</dt>
              <dd>{fact.value[locale]}</dd>
            </div>
          ))
        }
      </dl>
      {
        locale === "pt" && (
          <p>
            {start.more.lead.pt}
            <a class={linkClass} href={guidePath("escolher-a-solucao")}>
              {start.more.chooser.pt}
            </a>
            {start.more.after.pt}
            <a class={linkClass} href={guidePath("wallet-of-satoshi-antiga")}>
              {start.more.migration.pt}
            </a>
            .
          </p>
        )
      }
    </div>
  </section>

  <div class="mx-auto w-full max-w-5xl px-4 sm:px-8">
    <Contact />
  </div>
</Layout>
