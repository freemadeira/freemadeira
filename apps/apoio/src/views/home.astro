---
import { toLocale } from "@freemadeira/i18n";
import { buttonVariants } from "@freemadeira/ui/components/button";
import {
  ArrowRight,
  BookOpen,
  Check,
  Clock,
  MessageCircleQuestion,
  Printer,
} from "lucide-react";

import Madeira from "@/assets/illustrations/madeira.svg";
import Contact from "@/components/contact.astro";
import { tierSoft, tierVars } from "@/components/tiers";
import { CHAPTERS, TIERS } from "@/data";
import { start } from "@/data/home";
import { guidePath, routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
const linkClass = "underline underline-offset-4 hover:text-dark";

interface Resource {
  href: string;
  hreflang?: string;
  Icon: typeof BookOpen;
  label: string;
}

// The guide's chapters and extras are Portuguese only: the English home links
// to the Portuguese guide and to the flyer, which has an English page.
const resources: Resource[] =
  locale === "pt"
    ? [
        {
          Icon: MessageCircleQuestion,
          href: guidePath("perguntas-frequentes"),
          label: m.home_faq({}, t),
        },
        { Icon: Printer, href: routes.flyer.pt, label: m.home_flyer({}, t) },
        {
          Icon: BookOpen,
          href: guidePath("glossario"),
          label: m.home_glossary({}, t),
        },
      ]
    : [
        {
          Icon: BookOpen,
          href: routes.home.pt,
          hreflang: "pt",
          label: `${m.nav_guide({}, t)} (PT)`,
        },
        { Icon: Printer, href: routes.flyer.en, label: m.home_flyer({}, t) },
      ];
---

<Layout paths={routes.home}>
  <section
    class="mx-auto grid w-full max-w-5xl items-center gap-10 px-4 pt-12 pb-10 sm:px-8 sm:pt-20 md:grid-cols-[minmax(0,1fr)_18rem] lg:grid-cols-[minmax(0,1fr)_22rem]"
  >
    <div>
      <h1 class:list={[heading.h3, "max-w-[18ch] font-medium tracking-[-0.01em]"]}>
        {m.home_headline({}, t)}
      </h1>
      <p class="mt-6 max-w-xl text-xl text-pretty text-mountain-mist-600">
        {m.home_sub({}, t)}
      </p>
      <p class="mt-8">
        <a class={buttonVariants({ size: "lg", variant: "fm" })} href="#comecar">
          {m.home_start_button({}, t)}
          <ArrowRight aria-hidden="true" className="size-5" strokeWidth={1.75} />
        </a>
      </p>
    </div>
    <Madeira aria-hidden="true" class="hidden h-auto w-full md:block" />
  </section>

  {
    locale === "pt" ? (
      <section
        aria-labelledby="apoio-guide"
        class="mx-auto w-full max-w-5xl px-4 pt-10 sm:px-8"
      >
        <h2 class={heading.h5} id="apoio-guide">
          {m.home_guide_title({}, t)}
        </h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {TIERS.map((tier, index) => (
            <div
              class:list={[
                tierVars[tier.id],
                tierSoft,
                "flex flex-col rounded-3xl p-6 sm:p-7",
              ]}
            >
              <span
                aria-hidden="true"
                class="grid size-10 place-items-center rounded-full bg-(--tier) text-lg font-semibold text-(--tier-ink) tabular-nums"
              >
                {index + 1}
              </span>
              <h3 class="mt-5 text-xl leading-snug font-semibold text-pretty">
                {tier.label}
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-pretty text-mountain-mist-600">
                {tier.note}
              </p>
              <ul class="-mx-3 mt-5 border-t border-black/8 pt-3">
                {CHAPTERS.filter((chapter) => chapter.tier === tier.id).map(
                  (chapter) => (
                    <li>
                      <a
                        class="group flex items-baseline gap-3 rounded-xl px-3 py-2.5 leading-snug transition-colors duration-150 hover:bg-white/70"
                        href={guidePath(chapter.slug)}
                      >
                        <span class="w-5 shrink-0 text-sm font-semibold text-(--tier-text) tabular-nums">
                          {chapter.num}
                        </span>
                        <span class="grow text-pretty">{chapter.title}</span>
                        <ArrowRight
                          aria-hidden="true"
                          className="size-4 shrink-0 translate-y-0.5 text-mountain-mist-500 opacity-0 transition-[opacity,translate] duration-150 ease-out group-hover:opacity-100 motion-safe:-translate-x-1 motion-safe:group-hover:translate-x-0"
                          strokeWidth={2}
                        />
                      </a>
                    </li>
                  )
                )}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="mx-auto w-full max-w-5xl px-4 pt-6 sm:px-8">
        <p class="max-w-xl text-lg">{m.home_guide_in_portuguese({}, t)}</p>
      </section>
    )
  }

  <div class="mx-auto mt-4 w-full max-w-5xl px-4 sm:px-8">
    <ul class="grid gap-3 sm:grid-cols-3">
      {
        resources.map(({ href, hreflang, Icon, label }) => (
          <li>
            <a
              class="group flex h-full items-center gap-3 rounded-2xl border border-transparent bg-white p-3 pr-4 font-medium shadow-border transition-shadow duration-150 hover:shadow-border-hover"
              href={href}
              hreflang={hreflang}
              lang={hreflang}
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-bridal-50">
                <Icon aria-hidden="true" className="size-5" strokeWidth={1.75} />
              </span>
              <span class="grow leading-snug">{label}</span>
              <ArrowRight
                aria-hidden="true"
                className="size-4 shrink-0 text-mountain-mist-500 transition-[translate] duration-150 ease-out motion-safe:group-hover:translate-x-0.5"
                strokeWidth={2}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <section
    aria-labelledby="comecar-title"
    class="mx-auto w-full max-w-5xl px-4 pt-24 sm:px-8"
    id="comecar"
  >
    <h2 class={heading.h4} id="comecar-title">{start.title[locale]}</h2>
    <p class="mt-3 text-lg text-mountain-mist-600">{start.lead[locale]}</p>

    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {
        start.steps.map((step, index) => (
          <li class="flex flex-col rounded-3xl bg-bridal-50 p-6">
            <span
              aria-hidden="true"
              class="grid size-9 place-items-center rounded-full bg-primary-400 font-semibold text-dark tabular-nums"
            >
              {index + 1}
            </span>
            <p class="mt-4 text-lg leading-snug font-semibold">
              {step.title[locale]}
            </p>
            {step.text && (
              <p class="mt-1 text-pretty text-mountain-mist-600">
                {step.text[locale]}
              </p>
            )}
            {step.extra === "stores" && (
              <ul
                aria-label={m.start_stores_label({}, t)}
                class="mt-auto flex flex-wrap gap-2 pt-5"
              >
                {start.stores.map((store) => (
                  <li>
                    <a
                      class={buttonVariants({ size: "sm", variant: "fm-outline" })}
                      href={store.href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {store.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {step.extra === "duration" && (
              <p class="mt-auto pt-5">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-sm font-medium">
                  <Clock aria-hidden="true" className="size-4" strokeWidth={2} />
                  {start.duration[locale]}
                </span>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <div class="mt-12 grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <ul class="space-y-4">
        {
          start.points.map((point) => (
            <li class="flex gap-3">
              <span
                aria-hidden="true"
                class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-primary-400 text-dark"
              >
                <Check className="size-3.5" strokeWidth={3} />
              </span>
              <span class="text-pretty">{point[locale]}</span>
            </li>
          ))
        }
      </ul>
      <dl class="grid content-start gap-3 sm:grid-cols-2">
        {
          start.facts.map((fact) => (
            <div class="flex flex-col rounded-2xl border border-transparent bg-white p-5 shadow-border">
              <dt class="text-sm text-mountain-mist-600">{fact.label[locale]}</dt>
              <dd class="mt-1 text-2xl leading-tight font-semibold">
                {fact.value[locale]}
              </dd>
              {fact.detail && (
                <dd class="mt-2 text-sm leading-relaxed text-pretty text-mountain-mist-600">
                  {fact.detail[locale]}
                </dd>
              )}
            </div>
          ))
        }
      </dl>
    </div>

    {
      locale === "pt" && (
        <p class="mt-10 max-w-2xl text-pretty text-mountain-mist-600">
          {start.more.lead.pt}
          <a class={linkClass} href={guidePath("escolher-a-solucao")}>
            {start.more.chooser.pt}
          </a>
          {start.more.after.pt}
          <a class={linkClass} href={guidePath("wallet-of-satoshi-antiga")}>
            {start.more.migration.pt}
          </a>
          .
        </p>
      )
    }
  </section>

  <div class="mx-auto w-full max-w-5xl px-4 sm:px-8">
    <Contact atlantis />
  </div>
</Layout>
