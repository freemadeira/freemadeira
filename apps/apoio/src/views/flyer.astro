---
import { toLocale } from "@freemadeira/i18n";

import { FlyerViewer } from "@/components/flyer/flyer-viewer";
import PageHead from "@/components/page-head.astro";
import { routes } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
---

<Layout
  description={m.flyer_lead({}, t)}
  paths={routes.flyer}
  title={m.flyer_title({}, t)}
>
  <style is:global slot="head">
    /* Printing: only the flyer sheets, on A4 landscape; the site chrome stays out. */
    @page {
      size: A4 landscape;
      margin: 0;
    }
    @media print {
      body > *:not(.apoio-print-root) {
        display: none !important;
      }
      body {
        margin: 0;
      }
    }
  </style>
  <PageHead
    slug="folheto"
    lead={m.flyer_lead({}, t)}
    tier="extra"
    title={m.flyer_title({}, t)}
  />
  <div class="mx-auto w-full max-w-5xl px-4 pt-10 sm:px-8">
    <FlyerViewer client:load initial={locale} />
  </div>
</Layout>
