---
import { toLocale } from "@freemadeira/i18n";
import { ArrowLeft, ArrowRight } from "lucide-react";

import Blocks from "@/components/blocks.astro";
import Contact from "@/components/contact.astro";
import PageHead from "@/components/page-head.astro";
import { tierVars } from "@/components/tiers";
import { CHAPTERS, findPage } from "@/data";
import type { Page } from "@/data/types";
import { guidePath, guidePaths } from "@/i18n/routes";
import Layout from "@/layouts/base-layout.astro";
import { headingIds } from "@/lib/anchors";
import { m } from "@/paraglide/messages.js";

interface Props {
  page: Page;
}

const { page } = Astro.props;
const t = { locale: toLocale(Astro.currentLocale) };
const index = page.num ? CHAPTERS.findIndex((c) => c.slug === page.slug) : -1;
const prev = index > 0 ? CHAPTERS[index - 1] : undefined;
// The last chapter hands over to the glossary rather than ending the guide.
const next =
  index >= 0 ? (CHAPTERS[index + 1] ?? findPage("glossario")) : undefined;
const paths = guidePaths(page.slug);

// The table of contents: every heading, "Caminho …" sections included.
const ids = headingIds(page.blocks);
const toc = page.blocks.flatMap((block, at) => {
  const id = ids.get(at);
  return block.t === "h" && id ? [{ id, title: block.x }] : [];
});

const card =
  "group flex flex-col gap-1 rounded-2xl border border-transparent p-5 shadow-border transition-shadow duration-150 hover:shadow-border-hover";
const arrow =
  "size-4 transition-[translate] duration-150 ease-out";
---

<Layout
  alternates={{ pt: paths.pt }}
  description={page.lead}
  paths={paths}
  title={page.title}
>
  <article class={tierVars[page.tier]}>
    <PageHead
      lead={page.lead}
      num={page.num}
      slug={page.slug}
      tier={page.tier}
      title={page.title}
    />
    <div class="mx-auto w-full max-w-5xl px-4 pt-12 sm:px-8">
      <div
        class="lg:grid lg:grid-cols-[minmax(0,42rem)_12rem] lg:justify-between lg:gap-12"
      >
        <div class="mx-auto max-w-[42rem] text-[1.125rem] leading-[1.75] lg:mx-0">
          <Blocks blocks={page.blocks} collapse={page.collapseSections} />
          {
            (prev || next) && (
              <nav class="mt-16 grid gap-3 sm:grid-cols-2 print:hidden">
                {prev ? (
                  <a class={card} href={guidePath(prev.slug)}>
                    <span class="flex items-center gap-1.5 text-sm text-mountain-mist-600">
                      <ArrowLeft
                        aria-hidden="true"
                        className={`${arrow} motion-safe:group-hover:-translate-x-0.5`}
                        strokeWidth={2}
                      />
                      {m.page_prev({}, t)}
                    </span>
                    <span class="text-lg leading-snug font-semibold text-pretty">
                      {prev.title}
                    </span>
                  </a>
                ) : (
                  <span />
                )}
                {next ? (
                  <a
                    class:list={[card, "items-end text-right sm:col-start-2"]}
                    href={guidePath(next.slug)}
                  >
                    <span class="flex items-center gap-1.5 text-sm text-mountain-mist-600">
                      {m.page_next({}, t)}
                      <ArrowRight
                        aria-hidden="true"
                        className={`${arrow} motion-safe:group-hover:translate-x-0.5`}
                        strokeWidth={2}
                      />
                    </span>
                    <span class="text-lg leading-snug font-semibold text-pretty">
                      {next.title}
                    </span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )
          }
        </div>
        {
          toc.length >= 3 && (
            <aside class="hidden lg:block print:hidden">
              <nav
                aria-labelledby="apoio-toc"
                class="no-scrollbar sticky top-24 max-h-[calc(100dvh-8rem)] overflow-y-auto overscroll-contain"
              >
                <p class="text-sm font-semibold" id="apoio-toc">
                  {m.toc_title({}, t)}
                </p>
                <ol class="apoio-toc mt-3 border-l border-black/8">
                  {toc.map((entry) => (
                    <li>
                      <a
                        class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm leading-snug text-pretty text-mountain-mist-600 transition-colors duration-150 hover:text-dark"
                        href={`#${entry.id}`}
                      >
                        {entry.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>
      <Contact atlantis={page.slug === "dar-a-conhecer-o-negocio"} />
    </div>
  </article>
</Layout>

<style>
  /* Where the browser can tell which heading is on screen, its entry in the
     table of contents is marked. Elsewhere the list simply has no mark. */
  .apoio-toc {
    scroll-target-group: auto;
  }
  .apoio-toc a:target-current {
    border-color: var(--tier);
    color: var(--color-dark);
    font-weight: 600;
  }
</style>
