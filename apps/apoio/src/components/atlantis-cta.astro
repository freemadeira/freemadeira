---
import { buttonVariants } from "@freemadeira/ui/components/button";
import { toLocale } from "@freemadeira/i18n";

import { contact, freeMadeira } from "@/data/organisation";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

const locale = toLocale(Astro.currentLocale);
const t = { locale };
const subject = encodeURIComponent(m.atlantis_email_subject({}, t));
---

<section
  aria-labelledby="apoio-atlantis"
  class="my-14 bg-bridal-700 px-6 py-8 text-white sm:px-10 sm:py-10 print:hidden"
>
  <h2 class={heading.h5} id="apoio-atlantis">{m.atlantis_title({}, t)}</h2>
  <p class="my-4 max-w-xl">{m.atlantis_text({}, t)}</p>
  <div class="flex flex-wrap gap-3">
    <a
      class={buttonVariants({ variant: "fm" })}
      href={`mailto:${contact.email}?subject=${subject}`}
    >
      {m.atlantis_button({}, t)}
    </a>
    <a
      class={buttonVariants({ variant: "fm-outline-light" })}
      href={freeMadeira.partnerships[locale]}
    >
      {m.atlantis_partnerships({}, t)}
    </a>
  </div>
</section>
