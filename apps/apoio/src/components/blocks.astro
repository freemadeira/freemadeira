---
import { ChevronDown } from "lucide-react";

import type { Block as BlockData } from "@/data/types";
import { headingIds } from "@/lib/anchors";

import Block from "./block.astro";

interface Props {
  blocks: BlockData[];
  /** Group every "Caminho …" heading and what follows it into a section. */
  collapse?: boolean;
}

const { blocks, collapse = false } = Astro.props;
const ids = headingIds(blocks);

interface Leaf {
  block: BlockData;
  id?: string;
}
interface Section {
  blocks: Leaf[];
  id?: string;
  open: boolean;
  t: "section";
  title: string;
}
type Item = Leaf | Section;

// "Caminho …" headings start a collapsible section that runs to the next one.
function group(list: BlockData[]): Item[] {
  const out: Item[] = [];
  let current: Section | undefined;
  for (const [index, block] of list.entries()) {
    const id = ids.get(index);
    if (collapse && block.t === "h" && block.x.startsWith("Caminho ")) {
      current = {
        blocks: [],
        id,
        open: block.x.startsWith("Caminho A"),
        t: "section",
        title: block.x,
      };
      out.push(current);
    } else if (current) {
      current.blocks.push({ block, id });
    } else {
      out.push({ block, id });
    }
  }
  return out;
}

const items = group(blocks);
---

{
  items.map((item) =>
    "t" in item ? (
      <details
        class="group border-b border-black/8 first:border-t [:not(details)+&]:mt-8 [:not(details)+&]:border-t"
        id={item.id}
        open={item.open}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-xl leading-snug font-semibold [&::-webkit-details-marker]:hidden">
          {item.title}
          <ChevronDown
            aria-hidden="true"
            className="size-5 shrink-0 text-mountain-mist-500 group-open:rotate-180 motion-safe:transition-[rotate] motion-safe:duration-200 motion-safe:ease-out"
            strokeWidth={2}
          />
        </summary>
        <div class="pb-4">
          {item.blocks.map((leaf) => (
            <Block block={leaf.block} id={leaf.id} />
          ))}
        </div>
      </details>
    ) : (
      <Block block={item.block} id={item.id} />
    )
  )
}
