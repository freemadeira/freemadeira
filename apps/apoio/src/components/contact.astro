---
import { toLocale } from "@freemadeira/i18n";
import { Image } from "astro:assets";

import whatsappQr from "@/assets/flyer/whatsapp-support-qr.svg";
import { contact } from "@/data/organisation";
import { heading } from "@/lib/typography";
import { m } from "@/paraglide/messages.js";

import AtlantisCta from "./atlantis-cta.astro";

const t = { locale: toLocale(Astro.currentLocale) };
---

<AtlantisCta />
<section
  aria-labelledby="apoio-contact"
  class="mt-6 border-t border-mountain-mist-200 pt-8"
>
  <h2 class={heading.h5} id="apoio-contact">{m.contact_title({}, t)}</h2>
  <p class="my-3 max-w-2xl">{m.contact_text({}, t)}</p>
  <div class="flex flex-wrap items-center gap-4">
    <a
      href={contact.whatsapp}
      rel="noopener noreferrer"
      target="_blank"
    >
      <Image
        alt={m.contact_qr_alt({}, t)}
        class="rounded bg-white p-1.5"
        height={120}
        src={whatsappQr}
        width={120}
      />
    </a>
    <div>
      <p>
        <a
          class="underline underline-offset-4"
          href={contact.whatsapp}
          rel="noopener noreferrer"
          target="_blank"
        >
          {m.contact_whatsapp({}, t)}
        </a>
        <br />
        {m.contact_whatsapp_text({}, t)}
      </p>
      <p class="mt-2">
        <a class="underline underline-offset-4" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
      </p>
    </div>
  </div>
</section>
