---
import { Image } from "astro:assets";

import type { Block as BlockData } from "@/data/types";

import { tierSoft } from "./tiers";
import { Chooser, Inflation, Taps, Timeline, Triage } from "./widgets";

interface Props {
  block: BlockData;
  /** The heading's id, for the table of contents. */
  id?: string;
}

const { block, id } = Astro.props;

/**
 * Most list items open with a short sentence that says the point and go on to
 * explain it. Splitting there lets the point be bold, so a list can be skimmed.
 */
function headline(item: string): [string, string] | null {
  const end = item.indexOf(". ");
  return end > 0 && end < 70 ? [item.slice(0, end + 1), item.slice(end + 2)] : null;
}

// Images and widgets are wider than the text until the table of contents
// takes the right-hand column, from lg up.
const wide =
  "relative left-1/2 w-[min(56rem,calc(100vw-2rem))] -translate-x-1/2 lg:left-0 lg:w-full lg:translate-x-0";
---

{block.t === "p" && <p class="my-5">{block.x}</p>}
{
  block.t === "h" && (
    <h2
      class="mt-16 mb-3 text-[1.75rem] leading-tight font-semibold tracking-[-0.01em] text-pretty sm:text-3xl"
      id={id}
    >
      {block.x}
    </h2>
  )
}
{
  block.t === "ul" && (
    <ul class="my-5 list-disc space-y-2.5 pl-6 marker:text-(--tier-text)">
      {block.x.map((item) => {
        const split = headline(item);
        return split ? (
          <li>
            <strong>{split[0]}</strong> {split[1]}
          </li>
        ) : (
          <li>{item}</li>
        );
      })}
    </ul>
  )
}
{
  block.t === "ol" && (
    <ol class="my-5 list-decimal space-y-2.5 pl-6 marker:font-bold marker:text-(--tier-text)">
      {block.x.map((item) => {
        const split = headline(item);
        return split ? (
          <li>
            <strong>{split[0]}</strong> {split[1]}
          </li>
        ) : (
          <li>{item}</li>
        );
      })}
    </ol>
  )
}
{
  block.t === "note" && (
    <aside class:list={[tierSoft, "my-10 rounded-2xl px-6 py-5 sm:px-8 sm:py-6"]}>
      <strong class="block text-lg">{block.title}</strong>
      {block.x.map((paragraph) => (
        <p class="mt-2">{paragraph}</p>
      ))}
    </aside>
  )
}
{
  block.t === "img" && (
    <figure class:list={[wide, "my-12"]}>
      <Image
        alt={block.alt}
        class="h-auto w-full rounded-2xl bg-bridal-50 outline outline-1 -outline-offset-1 outline-black/10"
        sizes="(max-width: 896px) 100vw, 896px"
        src={block.src}
        width={1344}
        widths={[672, 896, 1344]}
      />
      {block.caption && (
        <figcaption class="mt-3 text-sm text-pretty text-mountain-mist-600">
          {block.caption}
        </figcaption>
      )}
    </figure>
  )
}
{block.t === "widget" && block.id === "inflation" && <Inflation client:visible />}
{block.t === "widget" && block.id === "timeline" && <Timeline client:visible />}
{block.t === "widget" && block.id === "chooser" && <Chooser client:visible />}
{block.t === "widget" && block.id === "taps" && <Taps client:visible />}
{block.t === "widget" && block.id === "triage" && <Triage client:visible />}
{
  block.t === "stats" && (
    <dl class="my-10 grid gap-3 sm:grid-cols-3">
      {block.x.map((stat) => (
        <div class="flex flex-col-reverse justify-end rounded-2xl bg-bridal-50 p-5">
          <dt class="mt-1 text-[0.95rem] leading-snug text-pretty text-mountain-mist-600">
            {stat.label}
          </dt>
          <dd class="text-3xl leading-tight font-semibold tracking-[-0.01em] tabular-nums">
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
  )
}
{
  block.t === "table" && block.rows.length === 1 && block.head.every(Boolean) && (
    <dl class="my-10 grid gap-3 sm:auto-cols-fr sm:grid-flow-col">
      {block.head.map((title, index) => (
        <div class:list={[tierSoft, "rounded-2xl p-5"]}>
          <dt class="leading-snug font-semibold text-pretty">{title}</dt>
          <dd class="mt-2 text-base leading-relaxed text-pretty">
            {block.rows[0]?.[index]}
          </dd>
        </div>
      ))}
    </dl>
  )
}
{
  block.t === "table" && !(block.rows.length === 1 && block.head.every(Boolean)) && (
    <div
      aria-label={block.head.filter(Boolean).join(" · ")}
      class="my-10 overflow-x-auto rounded-2xl border border-transparent shadow-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      role="region"
      tabindex="0"
    >
      {/* Wide enough that prose columns scroll on a phone instead of
          squeezing to a word per line. */}
      <table class="w-full min-w-xl border-collapse text-left text-[0.95rem] leading-relaxed">
        <thead class="bg-bridal-50">
          <tr>
            {block.head.map((cell) => (
              <th class="px-4 py-3 font-semibold first:min-w-44" scope="col">
                {cell}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {block.rows.map((row) => (
            <tr class="border-t border-black/8">
              {row.map((cell, index) =>
                index === 0 && block.head[0] === "" ? (
                  <th class="px-4 py-3 align-top font-semibold" scope="row">
                    {cell}
                  </th>
                ) : (
                  <td class="px-4 py-3 align-top">{cell}</td>
                )
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
